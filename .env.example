APP_NAME=AuraCap
APP_ENV=development
# output language: zh-CN (Chinese) or en-US (English); insights/summary prompts, timeline titles, sync
OUTPUT_LOCALE=zh-CN

# Note:
# - Self-host / cloud deploy reads this .env.
# - GitHub-only path should configure the same keys in Actions Secrets/Variables instead of relying on .env.

# timeline timezone and timestamp format (strftime)
DEFAULT_TIMEZONE=local
TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S %Z

# storage paths (timeline file, insights/summary/customized/task_index dirs)
STORAGE_ROOT=storage
TIMELINE_FILE=storage/timeline.md
INSIGHTS_DIR=storage/insights
SUMMARY_DIR=storage/summary
CUSTOMIZED_DIR=storage/customized
TASK_INDEX_DIR=storage/task_index
ENTRY_TAGS_FILE=storage/entry_tags.json

# prompts (custom paths override defaults)
PROMPTS_DIR=prompts
TIMELINE_PROMPT_FILE=prompts/timeline_prompts.md
# timeline language: request_locale=use locale; content_detect=auto-detect (screenshots +1 VL call)
TIMELINE_LANG_MODE=request_locale
INSIGHTS_PROMPT_FILE=prompts/insights_prompts.md
SUMMARY_PROMPT_FILE=prompts/summary_prompts.md
CUSTOMIZED_PROMPT_FILE=prompts/customized_prompts.md
TAGGING_PROMPT_FILE=prompts/tagging_prompts.md

# feature flags (EXTRACT_ONLY=skip insights/summary; ENABLE_SCHEDULER=master switch)
EXTRACT_ONLY=false
ENABLE_SCHEDULER=true
# FORCE_SCHEDULED_TASKS: when true, run insight/summary regardless of cron (for manual trigger); GitHub Actions sets this for workflow_dispatch
FORCE_SCHEDULED_TASKS=false
ENABLE_INSIGHTS=true
ENABLE_SUMMARY=true
# 任务索引（tag + 按 tag 权重的日/周索引）
ENABLE_TASK_INDEX=true
# 索引中展示的 top N 个 tag，如 3 表示只显示出现最多的 3 个主题
TASK_INDEX_TOP_N=3
ENABLE_CUSTOM_OPERATION=false
# audio: TRANSCRIBE_THEN_ANALYZE=ASR+text; DIRECT_MULTIMODAL=MM direct (no ASR)
AUDIO_MODE=TRANSCRIBE_THEN_ANALYZE

# providers (TEXT=insights/summary/transcript analysis; MM=screenshot+audio direct; ASR=speech-to-text)
TEXT_PROVIDER=mock
MM_PROVIDER=mock
ASR_PROVIDER=mock
# unified mode: when set (e.g. openai, google), TEXT/MM/ASR all use same provider, one API key; TEXT_PROVIDER/MM_PROVIDER/ASR_PROVIDER are ignored, can omit them
UNIFIED_PROVIDER=
PROVIDER_TIMEOUT_SECONDS=120

# OpenAI (also for OpenAI-compatible third-party: SiliconFlow, OpenRouter, DeepSeek, etc.)
# For third-party: change OPENAI_BASE_URL and OPENAI_API_KEY; model names per provider docs
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_MM_MODEL=gpt-4.1-mini
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TEXT_MODEL=claude-3-7-sonnet-latest
ANTHROPIC_MM_MODEL=claude-3-7-sonnet-latest

# Google
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_TEXT_MODEL=gemini-2.0-flash
GOOGLE_MM_MODEL=gemini-2.0-flash
GOOGLE_ASR_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_MM_MODEL=llama-3.2-90b-vision-preview
GROQ_ASR_MODEL=whisper-large-v3

# Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TEXT_MODEL=mistral-large-latest
MISTRAL_MM_MODEL=pixtral-large-latest
MISTRAL_ASR_MODEL=voxtral-mini-latest

# Soniox (ASR-only async STT; set ASR_PROVIDER=soniox to use)
SONIOX_API_KEY=
SONIOX_BASE_URL=https://api.soniox.com
SONIOX_MODEL=stt-async-v5

# transcribe-hub stub (vcvm diarization pipeline); unset = disabled, no external call (docs/TRANSCRIBE_HUB.md)
TRANSCRIBE_HUB_URL=

# input limits (MAX_UPLOAD_MB for /raw /upload; MAX_BASE64_CHARS for /json)
MAX_BASE64_CHARS=2000000
MAX_UPLOAD_MB=25
ALLOWED_IMAGE_MIME=image/png,image/jpeg,image/heic
ALLOWED_AUDIO_MIME=audio/m4a,audio/mp4,audio/mpeg,audio/wav,audio/x-wav

# schedule (cron: 0=Sunday; GitHub Actions uses UTC)
INSIGHTS_CRON=0 1 * * *
# INSIGHTS_TARGET_DAY_OFFSET: 0=today, 1=yesterday (for runs at e.g. 1am)
INSIGHTS_TARGET_DAY_OFFSET=1
SUMMARY_CRON=0 2 * * 0
SUMMARY_WINDOW_DAYS=7
# CUSTOM_OPERATION_MODE: ON_EACH_TRIGGER=per capture; CRON=on schedule
CUSTOM_OPERATION_MODE=ON_EACH_TRIGGER
CUSTOM_OPERATION_CRON=0 */6 * * *

# sync (SYNC_ENABLE + channel config; ON_EVENT=immediate, DAILY/CRON=batch)
SYNC_ENABLE=false
SYNC_DEFAULT_FREQUENCY=ON_EVENT
SYNC_DEFAULT_CRON=0 9 * * *
SYNC_SEND_TIMELINE=true
SYNC_SEND_INSIGHT=false
SYNC_SEND_SUMMARY=true
SYNC_SEND_CUSTOMIZED=false
SYNC_SEND_ERRORS=true

# sync channels (detailed config: docs/SYNC_CHANNELS.md)
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

WHATSAPP_ENABLED=false
WHATSAPP_GATEWAY_URL=
WHATSAPP_TOKEN=

# security (REQUEST_SIGNATURE_SECRET + X-AuraCap-Signature header when verification on)
REQUEST_SIGNATURE_SECRET=
SKIP_SIGNATURE_VERIFICATION=true

# github dispatch (Path A: .env; Path B: use AURACAP_RELEASE_INBOX_TAG etc. in Actions Variables)
GITHUB_DISPATCH_EVENT_TYPE=auracap_ingest
GITHUB_RELEASE_INBOX_TAG=auracap-inbox
GITHUB_RELEASE_DELETE_AFTER_PROCESS=true
